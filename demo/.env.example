# =============================================================================
# LLM 配置
# =============================================================================
# 使用方法：把本文件复制为 .env，填入你自己的 Key
#     cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 排除，绝不要把真实 Key 提交到 Git 仓库。
# =============================================================================


# ------------------------------ Anthropic Claude ------------------------------
# 充值：     https://platform.claude.com/settings/billing   （最低 $5）
# 创建 Key： https://platform.claude.com/settings/keys
#
# ⚠️ 注意：API 额度与 claude.ai 订阅 / Claude Code 用量是两套独立的计费系统，
#          订阅额度不能用于 API 调用，必须在 Console 单独充值。

LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-在这里填入你的Key

# 当前使用 Haiku 4.5 —— 开发调试阶段的省钱选择。
# 调 Prompt 时要反复跑几十次，用 haiku 单次约 $0.03，opus 约 $0.14。
# ⚠️ 录演示视频和最终交付前，记得改回 claude-opus-5，生成质量差别明显。
LLM_MODEL=claude-haiku-4-5

# 可选模型与价格（每百万 token，输入/输出）：
#   claude-opus-5     $5  / $25   能力最强，SkillSpec 生成质量最好 ← 交付时用
#   claude-sonnet-5   $3  / $15   （2026-08-31 前促销价 $2 / $10）
#   claude-haiku-4-5  $1  / $5    最便宜，调试阶段反复跑  ← 当前使用
#
# 成本参考：本 Demo 单次「生成 Skill + 执行分析」全流程
#   opus-5    约 $0.14 → $5 可跑约 35 轮
#   sonnet-5  约 $0.08 → $5 可跑约 60 轮
#   haiku-4-5 约 $0.03 → $5 可跑约 170 轮
#
# 三个模型都支持 structured output，所以切换不需要改任何代码。
# 注意 haiku-4-5 的上下文窗口是 200K（opus/sonnet 是 1M），
# 本项目的 Prompt 远小于这个量级，不受影响。


# ------------------------------- 其他可选供应商 -------------------------------
# 网关层做了抽象，换供应商只需改这几行，业务代码零改动。

# DeepSeek（更便宜，约 $0.14/$0.28）
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-xxxxx
# LLM_MODEL=deepseek-v4-flash

# 智谱 GLM
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=xxxxx
# LLM_MODEL=glm-4-plus


# ------------------------------- 演示模式 -------------------------------------
# 不配置任何 Key 时，系统自动降级为 mock 模式：
#   - 数值部分仍由确定性计算引擎真实算出
#   - 文字分析部分返回预置占位内容
# 这样面试官打开 Demo 链接时，不会因为额度耗尽看到报错页面。
#
# LLM_PROVIDER=mock
